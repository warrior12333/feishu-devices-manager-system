# ===== 基础 =====
# 服务端口
PORT=3000
# 对外访问地址（生产环境必须是公网 HTTPS 域名，与飞书重定向 URL 的域名一致）
BASE_URL=http://localhost:3000
# JWT 会话密钥，生产环境务必改成随机长字符串
JWT_SECRET=please-change-me-to-a-random-string

# ===== 管理员 =====
# 管理员的飞书 userid（open_id），逗号分隔；这些用户登录后自动拥有管理员角色
# 也可不配，由超管控制台「成员管理」中直接调整角色
ADMIN_USERIDS=

# ===== 本地开发 =====
# true 时跳过飞书登录，使用内置的三个测试账号（张三/管理员、李四/成员、王五/成员）
DEV_MODE=true

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ===== 图片上传目录（相对 server 目录）=====
UPLOAD_DIR=./uploads

# ===== 隐藏超管入口 /superadmin（独立账号密码，与飞书账号无关）=====
# 两项均非空时入口才启用；留空则 /superadmin 返回 404（入口不存在）
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=请改成随机长密码

# ===== 微信扫码借出 /m（可选，未配置时 /m 直接填写信息即可借用）=====
WX_OPEN_APPID=
WX_OPEN_SECRET=

# ===== 飞书自建应用（登录 /f 免登 + 审批通知卡片 + 通讯录同步）=====
# 开发者后台需配置重定向地址 https://<域名>/api/feishu/callback，
# 并开通「获取用户基本信息」「im:message」「通讯录读取」权限后发布
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 【已弃用】企业微信相关变量（平台已全面切换飞书，服务端不再读取）=====
# WECOM_CORP_ID=
# WECOM_AGENT_ID=
# WECOM_SECRET=
# SUITE_ID=
# SUITE_SECRET=
# WECOM_CALLBACK_TOKEN=
# WECOM_CALLBACK_AES_KEY=
