# ===== 基础 =====
# 服务端口
PORT=3000
# 对外访问地址（生产环境必须是公网 HTTPS 域名，企微可信域名要与它一致）
BASE_URL=http://localhost:3000
# JWT 会话密钥，生产环境务必改成随机长字符串
JWT_SECRET=please-change-me-to-a-random-string

# ===== 企业微信自建应用（模式 A）=====
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# ===== 开发者中心「网页应用」（第三方，模式 B）=====
# 开发者中心应用详情中获取
SUITE_ID=
SUITE_SECRET=
# 数据回调URL / 指令回调URL 的验签凭据，必须与企微后台填写的完全一致。
# 自行生成示例：
#   Token:    node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
#   AESKey:   node -e "console.log(require('crypto').randomBytes(32).toString('base64').slice(0,43))"
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# 管理员的企业微信 userid，逗号分隔（这些用户登录后自动拥有设备管理权限）
ADMIN_USERIDS=

# ===== 本地开发 =====
# true 时跳过企业微信登录，使用内置的三个测试账号（张三/管理员、李四/成员、王五/成员）
DEV_MODE=true

# ===== 存储 =====
# SQLite 数据库文件位置（相对 server 目录）
DB_FILE=./data/app.db
# 图片上传目录（相对 server 目录）
UPLOAD_DIR=./uploads

# ===== 隐藏超管入口 /superadmin(独立账号密码,与企微账号无关)=====
# 两项均非空时入口才启用;留空则 /superadmin 返回 404(入口不存在)
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=请改成随机长密码

# ===== 微信扫码借出(/m,微信开放平台「网站应用」)=====
WX_OPEN_APPID=
WX_OPEN_SECRET=

# ===== 飞书自建应用(/f 免登 + 审批通知卡片)=====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
